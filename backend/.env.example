# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=

# JWT
ACCESS_TOKEN_SECRET=replace_with_long_random_string
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_string
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Nodemailer (example: Gmail app password, or any SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Landslide Early Warning <your_email@gmail.com>"

# OTP
OTP_EXPIRY_MINUTES=5

# Redis (single active session enforcement + fast logout)
REDIS_URL=
SINGLE_SESSION_LOGIN=true

# ML model service (your Flask/FastAPI model server) - used when ML_MODE=direct
ML_MODEL_URL=http://127.0.0.1:8000/predict

# Dual model mode: "direct" calls ML_MODEL_URL with { latitude, longitude } and
# no auth; "apikey" calls a third-party API with an API key header instead.
ML_MODE=direct
EXTERNAL_ML_API_URL=
EXTERNAL_ML_API_KEY=

# Set to "true" to skip calling any model at all and use a built-in
# deterministic mock prediction instead - useful for demos/SIH judging when
# your real model isn't deployed yet. Set back to "false" once it is.
USE_MOCK_ML=true

# Risk threshold above which authorities are emailed (if model returns probability)
DISASTER_ALERT_THRESHOLD=0.5
